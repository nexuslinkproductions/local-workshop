import QtQuick

// Vertex texture fetch test scene: 64 points on a circle of known radius,
// positions read from a PNG in the VERTEX shader of a GridMesh ShaderEffect.
// Render with: tools/linux/v5-shot.sh tools/linux/tests/vtf.qml out.png 1280 720
// The data PNG is generated by tools/linux/tests/make_points.py.
Item {
    id: root
    width: 1280
    height: 720
    Rectangle { anchors.fill: parent; color: "#0a0d14" }

    ShaderEffect {
        anchors.fill: parent
        mesh: GridMesh { resolution: Qt.size(64, 1) }

        vertexShader: "vtf.vert.qsb"
        fragmentShader: "vtf.frag.qsb"

        property vector2d u_grid: Qt.vector2d(64, 1)
        property vector2d u_dataSize: Qt.vector2d(64, 1)
        property vector2d u_size: Qt.vector2d(width, height)
        property vector2d u_center: Qt.vector2d(width / 2, height / 2)
        property real u_radius: 240
        property real u_pointPx: 26
        property color u_color: "#7de3ff"

        property variant u_data: Image {
            source: "vtf-points.png"
            smooth: false
            // nearest filtering: one texel per point, no interpolation
            layer.enabled: false
        }
    }
}
