[Unit]
Description=Usage gauges collector (Claude, Devin, OpenCode Go, VRAM)
Documentation=file:%h/hud-wt/gauge-fix/nexuslink.hud/tokens/gauges.py

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/hud-wt/gauge-fix/nexuslink.hud/tokens/gauges.py run
Restart=always
RestartSec=10
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=default.target
