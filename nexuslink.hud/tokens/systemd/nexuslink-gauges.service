[Unit]
Description=Usage gauges collector (Claude, Devin, OpenCode Go, VRAM)
Documentation=file:%h/.local/lib/nexuslink/gauges.py

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/lib/nexuslink/gauges.py run
Restart=always
RestartSec=10
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=default.target
